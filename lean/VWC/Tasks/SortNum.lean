    exact ⟨le_trans (by norm_num [G]) h.1, le_trans h.2 (by norm_num [G])⟩

set_option maxHeartbeats 4000000 in
lemma num4 (W0 : ℝ) (hW : W0 * (5 + ∑ m ∈ range (4 + 1), rr 4 m) = 1) (s2 : ℝ)
    (hs : (432 / 100 : ℝ) ≤ s2 ∧ s2 ≤ 454 / 100) :
    (0 : ℝ) ≤ (39 / 200 : ℝ) ∧ (4 / 5 : ℝ) ≤ 1 ∧ (0 : ℝ) ≤ (4 / 5 : ℝ) ∧
    1 + OUT * SG * (39 / 200 : ℝ) < OUT * SG * ((4 / 5 : ℝ) - (39 / 200 : ℝ)) ∧
    1 + OUT * SG * (1 - (4 / 5 : ℝ)) < OUT * SG * ((4 / 5 : ℝ) - (39 / 200 : ℝ)) ∧
    0 ≤ GOx 4 W0 9 5 ∧ GOx 4 W0 9 5 ≤ 1 ∧
    ∀ e c : ℕ, e < 10 → c ≤ 5 →
      (c ≤ 4 → GOx 4 W0 e c - ((4 : ℕ) : ℝ) + (e + 1) * B2 * s2 ≤ (39 / 200 : ℝ) * SG * s2) ∧
      (4 < c → (4 / 5 : ℝ) * SG * s2 ≤ GOx 4 W0 e c - ((4 : ℕ) : ℝ) + (e + 1) * B2 * s2) := by
  obtain ⟨⟨al, ah⟩, ⟨g0l, g0h⟩, ⟨g1l, g1h⟩, ⟨g2l, g2h⟩, ⟨g3l, g3h⟩, ⟨g4l, g4h⟩⟩ := coef_b4 W0 hW
  obtain ⟨sl, sh⟩ := hs
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num [OUT, SG], by norm_num [OUT, SG], ?_, ?_, ?_⟩
  · simp only [GOx, sum_range_succ, sum_range_zero]; norm_num [mu, Sx]; linarith [g0l, g0h, g1l, g1h, g2l, g2h, g3l, g3h, g4l, g4h, al, ah]
  · simp only [GOx, sum_range_succ, sum_range_zero]; norm_num [mu, Sx]; linarith [g0l, g0h, g1l, g1h, g2l, g2h, g3l, g3h, g4l, g4h, al, ah]
  intro e c he hc
  interval_cases e <;> interval_cases c <;>
    simp only [GOx, sum_range_succ, sum_range_zero] <;> norm_num [mu, Sx, B2, SG] <;>
    linarith [g0l, g0h, g1l, g1h, g2l, g2h, g3l, g3h, g4l, g4h, al, ah, sl, sh]

/-- The per-step numeric facts, packaged for the mechanism proof. -/
theorem numeric (k : ℕ) (hk : k ≤ 4) (W0 : ℝ) (hW : W0 * (5 + ∑ m ∈ range (k + 1), rr k m) = 1)
    (s2 : ℝ) (hs : (432 / 100 : ℝ) ≤ s2 ∧ s2 ≤ 454 / 100) :
    ∃ θlo θhi : ℝ, 0 ≤ θlo ∧ θhi ≤ 1 ∧ 0 ≤ θhi ∧
      1 + OUT * SG * θlo < OUT * SG * (θhi - θlo) ∧ 1 + OUT * SG * (1 - θhi) < OUT * SG * (θhi - θlo) ∧
      0 ≤ GOx k W0 9 5 ∧ GOx k W0 9 5 ≤ 1 ∧
      ∀ e c : ℕ, e < 10 → c ≤ 5 →
        (c ≤ k → GOx k W0 e c - k + (e + 1) * B2 * s2 ≤ θlo * SG * s2) ∧
        (k < c → θhi * SG * s2 ≤ GOx k W0 e c - k + (e + 1) * B2 * s2) := by
  interval_cases k
  · exact ⟨_, _, num0 W0 hW s2 hs⟩
  · exact ⟨_, _, num1 W0 hW s2 hs⟩
  · exact ⟨_, _, num2 W0 hW s2 hs⟩
  · exact ⟨_, _, num3 W0 hW s2 hs⟩
  · exact ⟨_, _, num4 W0 hW s2 hs⟩

end VWC.Arch.Sort
